# =============================================================================
# DEJ Intelligence - Environment Variables
# =============================================================================
# Copy to .env.local and fill in. NEVER commit .env.local.
# Production values live in Vercel project settings + 1Password.
# =============================================================================

# --- Supabase (required for Phase 0) -----------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-side only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Anthropic (required for Phase 4) ----------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# --- Stripe (required for Phase 6) -------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Price IDs - one per (tier x interval) combination
STRIPE_PRICE_SOLO_MONTHLY=price_...
STRIPE_PRICE_SOLO_ANNUAL=price_...
STRIPE_PRICE_FIRM_MONTHLY=price_...
STRIPE_PRICE_FIRM_ANNUAL=price_...
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_...
STRIPE_PRICE_ENTERPRISE_ANNUAL=price_...

# --- Email (required for Phase 5) --------------------------------------------
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=alerts@intel.dejsearch.com

# --- Inngest (required for Phase 1+) -----------------------------------------
INNGEST_EVENT_KEY=...
INNGEST_SIGNING_KEY=...

# --- App config --------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
